{
  "name": "invoice-collector",
  "version": "0.6.2",
  "description": "Open-source browser extension that collects supplier invoices and receipts from vendor portals using the user's own session — no credential custody.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run gen:icons && vite",
    "build": "npm run gen:icons && vite build",
    "gen:icons": "tsx scripts/build-icons.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-vendors.ts",
    "export-recipes": "tsx scripts/export-recipes.ts",
    "ci": "npm run gen:icons && npm run typecheck && npm run validate && npm run test"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "simple-icons": "^16.26.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
