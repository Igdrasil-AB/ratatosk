{
  "$comment": "Frozen shared contract for minting and revoking the upload-only Collector credential. Mirrored byte-for-byte into the Igdrasil repository.",
  "mint": {
    "$comment": "UPSERT: ON CONFLICT (company_id) DO UPDATE rotates the token. A second mint for the same company invalidates the first credential, so the extension's connect handler must accept a re-connect rather than refuse it.",
    "upsert": true,
    "method": "POST",
    "path": "/api/v1/integrations/invoice-collector/token",
    "alsoServedAt": "/api/integrations/invoice-collector/token",
    "auth": "clerk_bearer",
    "headers": { "required": ["Authorization", "X-Company-Id", "Content-Type"] },
    "request": { "connection_state": "<64 hex>" },
    "response": {
      "status": 200,
      "body": { "token": "rat_<64 hex>", "expires_at": "2026-11-06T00:00:00Z" },
      "headers": { "Cache-Control": "no-store", "Pragma": "no-cache" }
    },
    "refusals": {
      "missingState": 400,
      "malformedState": 400,
      "reusedState": 400,
      "unboundState": 400,
      "noUserAuth": 401
    }
  },
  "revoke": {
    "method": "DELETE",
    "path": "/api/documents/ingest/token",
    "auth": "collector_bearer",
    "headers": { "required": ["Authorization", "X-Company-Id"] },
    "response": { "status": 204 },
    "idempotent": {
      "$comment": "An already-revoked token answers 401, which the Collector treats as success so disconnect stays idempotent.",
      "status": 401,
      "collectorTreatsAsSuccess": true
    }
  },
  "credential": {
    "pattern": "^rat_[a-f0-9]{64}$",
    "storedServerSide": "sha256_hex_only",
    "lifetimeDays": 90,
    "scope": "upload-only, one per (company, browser profile)",
    "sessionJwtAccepted": false
  }
}
